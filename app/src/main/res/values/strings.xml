    <string name="health_permissions_dialog_title_request">Health Connect permissions</string>
    <string name="health_permissions_dialog_title_info">Health Connect data access</string>
    <string name="health_permissions_dialog_intro">FlexInsight only requests Health Connect access if you turn it on. Each permission below is optional until you enable the integration. Data is read on your device for recovery scores and AI coaching — we do not upload Health Connect data to our servers.</string>
    <string name="health_permissions_dialog_footer">You can revoke access anytime in the Health Connect app. Write access is only used when you enable “Write workouts to Health Connect” and view-only mode is off.</string>
