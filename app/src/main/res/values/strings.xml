    <string name="health_perm_read_sleep_title">Read sleep</string>
    <string name="health_perm_read_sleep_why">Used for Recovery score, training load, deload hints, and AI coaching (e.g. sleep duration last night).</string>
    <string name="health_perm_read_hr_title">Read heart rate</string>
    <string name="health_perm_read_hr_why">Used to estimate resting heart rate for recovery context — not for medical diagnosis.</string>
    <string name="health_perm_read_steps_title">Read steps</string>
    <string name="health_perm_read_steps_why">Used to factor daily walking activity into training load (e.g. leg day after a high-step day).</string>
    <string name="health_perm_read_calories_title">Read active calories</string>
    <string name="health_perm_read_calories_why">Used to understand non-gym calorie burn alongside Hevy workout volume.</string>
    <string name="health_perm_read_exercise_title">Read exercise sessions</string>
    <string name="health_perm_read_exercise_why">Used to count cardio or other workouts logged outside Hevy (runs, rides, etc.) for weekly load.</string>
    <string name="health_perm_write_exercise_title">Write exercise sessions</string>
    <string name="health_perm_write_exercise_why">Optional. Copies completed Hevy strength workouts into your Health Connect timeline so they appear in Google Fit / Samsung Health. Off unless you enable write in Settings.</string>
